<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.camel.quarkus</groupId>
        <artifactId>camel-quarkus-build-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../poms/build-parent/pom.xml</relativePath>
    </parent>

    <artifactId>camel-quarkus-documentation-rag</artifactId>
    <name>Camel Quarkus :: Documentation :: RAG</name>

    <description>Vector embeddings of the extension reference pages, so that AI coding assistants can
        search them through the Quarkus Agent MCP server. Every extension deployment JAR carries a
        META-INF/quarkus-rag-artifact.properties pointer to this artifact; the server resolves it at the
        version of the extension that points to it and loads the embeddings on demand.</description>

    <properties>
        <!-- Generating ~1000 embeddings is too slow for a -Dquickly build. Flipped by the 'full'
             profile below, so a normal build and a release both produce them. -->
        <quarkus-rag.skip>true</quarkus-rag.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <!-- Reads every generated extension reference page in one pass. The RAG source name of
                     each chunk comes from the ':extensions:' attribute of the page, which
                     camel-quarkus-maven-plugin:update-extension-doc-page writes. Shared configuration
                     (guideBaseUrl, Antora attributes) lives in the root pom pluginManagement. -->
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-documentation-rag-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-extension-rag</id>
                        <goals>
                            <goal>generate-rag</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <guidesDirectory>${maven.multiModuleProjectDirectory}/docs/modules/ROOT/pages/reference/extensions</guidesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>full</id>
            <activation>
                <property>
                    <name>!quickly</name>
                </property>
            </activation>
            <properties>
                <quarkus-rag.skip>false</quarkus-rag.skip>
            </properties>
        </profile>
    </profiles>

</project>
